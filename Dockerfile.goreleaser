# Dockerfile for GoReleaser builds
# The binary is pre-built by GoReleaser

# Final stage (Debian for glibc)
FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies (transcoding: ffmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built binary from GoReleaser — dockers_v2 stages the build
# context with per-platform subdirectories (see goreleaser.com/deprecations#dockers).
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/whatomate .



# Create directories
RUN mkdir -p /app/uploads /app/audio

# Expose port
EXPOSE 8080

# Run the binary
ENTRYPOINT ["./whatomate"]
CMD ["server", "-migrate"]
